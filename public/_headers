# Asset caching headers for Cloudflare Pages (mirrors firebase.json)
/*
  X-Robots-Tag: all

/*.js
  Cache-Control: max-age=31536000

/*.css
  Cache-Control: max-age=31536000

/*.jpg
  Cache-Control: max-age=31536000

/*.jpeg
  Cache-Control: max-age=31536000

/*.png
  Cache-Control: max-age=31536000

/*.gif
  Cache-Control: max-age=31536000

/*.svg
  Cache-Control: max-age=31536000

/*.webp
  Cache-Control: max-age=31536000
